# Copie este arquivo para .env e preencha com os endereços das APIs.
# Variáveis EXPO_PUBLIC_* são embutidas no app no momento do build (não coloque segredos aqui).
#
# Local: no emulador Android o localhost do PC é 10.0.2.2; no celular físico use o IP do PC na rede.
# Publicado: use as URLs da nuvem (Azure).

# API de funções (Java/Spring, porta 8080) — idosos, medicamentos, consultas, atividades
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# API de autenticação (Java/Spring, porta 8081) — /autenticacao/login, /sair, /cadastro
EXPO_PUBLIC_AUTH_URL=http://10.0.2.2:8081
