# Copie este arquivo para .env e preencha com os endereços das APIs publicadas.
# Variáveis EXPO_PUBLIC_* são embutidas no app no momento do build (não coloque segredos aqui).

# API de funções (Java/Spring) — idosos, medicamentos, consultas, atividades
EXPO_PUBLIC_API_URL=https://sua-api-funcoes.azurewebsites.net

# API de autenticação — POST /auth/login e POST /auth/cadastro (emite o JWT)
# Se a autenticação estiver na mesma API, pode repetir o endereço acima.
EXPO_PUBLIC_AUTH_URL=https://sua-api-autenticacao.azurewebsites.net
